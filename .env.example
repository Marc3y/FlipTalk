# ─────────────────────────────────────────────────────────────────────────────
# FlipTalk configuration
#
# LOCAL:  cp .env.example .env.local  → `npm run dev`. Everything below is
#         optional locally. With nothing set you get: mock login (type any
#         username), in-memory state, and SSE for realtime.
#
# VERCEL: add the same keys under Project → Settings → Environment Variables.
#         No code changes. NEXT_PUBLIC_* values are baked in at build time, so
#         redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth.js ──────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Twitch app: https://dev.twitch.tv/console/apps → Register Your Application
#   OAuth Redirect URLs (add both):
#     http://localhost:3000/api/auth/callback/twitch
#     https://<your-domain>/api/auth/callback/twitch
#   Category: Website Integration. Client type: Confidential.
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=

# Local only: force the mock login even when Twitch keys are set.
# Ignored in production builds; there the only way in is Twitch.
AUTH_MOCK=false

# ── Upstash Redis (room state + rate limiting) ───────────────────────────────
# https://console.upstash.com → Create database → REST API section.
# Using the Vercel Marketplace "Upstash" integration instead? It injects
# KV_REST_API_URL / KV_REST_API_TOKEN, which are picked up automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Realtime: PartyServer on Cloudflare (free) ───────────────────────────────
# The worker in /party keeps one WebSocket per viewer in a Durable Object per
# room. Runs on the Cloudflare Workers Free plan; idle sockets hibernate.
#   Deploy:  npm run party:install && npm run party:deploy
#            cd party && npx wrangler secret put PARTY_SECRET
#   Then set the host it prints (without https://), e.g.
#            fliptalk-party.<your-subdomain>.workers.dev
#
# Leave both empty and the app still works: SSE in `npm run dev`,
# CDN-cached polling in production (fine for small streams).
#
# Local test of the real worker: `npm run party:dev` (port 1999) and use
#   NEXT_PUBLIC_PARTY_HOST=localhost:1999
#   PARTY_SECRET=local-party-secret        (same value as party/.dev.vars)
NEXT_PUBLIC_PARTY_HOST=
PARTY_SECRET=
