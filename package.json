{
  "name": "fliptalk",
  "version": "0.1.0",
  "private": true,
  "description": "Reverse Voice Challenge for Twitch streamers and their chat.",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "party:install": "npm --prefix party install",
    "party:dev": "npm --prefix party run dev",
    "party:deploy": "npm --prefix party run deploy"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-auth": "5.0.0-beta.32",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
